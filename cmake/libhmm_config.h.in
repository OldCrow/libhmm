#pragma once

/**
 * @file config.h
 * @brief Build-time configuration facts, generated by CMake.
 *
 * GENERATED FILE — do not edit. The template is cmake/libhmm_config.h.in;
 * CMake writes the result to ${CMAKE_BINARY_DIR}/include/libhmm/config.h and
 * installs it alongside the hand-written headers.
 *
 * Everything here is a property of the BUILD, so it must reach every
 * translation unit that includes a libhmm header — the library's own TUs, the
 * test TUs, and installed consumers alike. Recording these as a header rather
 * than as target_compile_definitions is deliberate: a PRIVATE definition
 * reaches only the library's own sources, which silently gave test TUs and
 * consumers a different implementation of the same inline function than the
 * one the library shipped (an ODR violation — see issue #75).
 */

/// Defined when std::cyl_bessel_i (C++17 special math, §29.9.3) is available.
/// GCC 6.1+, MSVC 2017 15.5+. NOT AppleClang/libc++ as of Xcode 15, where
/// include/libhmm/math/bessel.h falls back to A&S §9.8.1-9.8.4 polynomials
/// accurate only to 1.6e-7.
#cmakedefine LIBHMM_HAS_CXX17_BESSEL
