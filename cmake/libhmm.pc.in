# Relocatable: prefix is derived from this file's own location, so
# `cmake --install <build> --prefix <other>` (and moving the tree) stay valid.
prefix=${pcfiledir}/@LIBHMM_PC_PREFIX_REL@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libhmm
Description: Modern C++20 Hidden Markov Model library
Version: @PROJECT_VERSION@
URL: https://github.com/OldCrow/libhmm

Requires:
Libs: -L${libdir} -lhmm
Libs.private: @LIBHMM_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -std=c++20
